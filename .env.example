# Copy this file to .env and fill in the values. The default values are sufficient for local use.

# Gemini API key from Google AI Studio. Empty = AI functions will return 503, the rest of the application works.
GEMINI_API_KEY=
# Gemini model (default values are in docker-compose.yml)
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Database (default values are sufficient for local use)
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=jobtracker

# S3 file storage (default values are sufficient for local use)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-tracker
